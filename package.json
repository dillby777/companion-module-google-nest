{
	"name": "google-nest",
	"version": "0.1.0",
	"main": "dist/main.js",
	"type": "module",
	"scripts": {
		"postinstall": "husky",
		"format": "prettier -w .",
		"package": "run build:og && companion-module-build",
		"build": "run build:main",
		"build:og": "rimraf dist && run build:main",
		"build:main": "tsc -p tsconfig.build.json",
		"dev": "tsc -p tsconfig.build.json --watch",
		"lint:raw": "eslint",
		"lint": "run lint:raw ."
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bitfocus/companion-module-google-nest.git"
	},
	"engines": {
		"node": "^22.20 || ^26.5",
		"yarn": "^4"
	},
	"dependencies": {
		"@companion-module/base": "2.0.4"
	},
	"devDependencies": {
		"@companion-module/tools": "^3.1.1",
		"@ianvs/prettier-plugin-sort-imports": "^4.7.1",
		"@tsconfig/node22": "^22.0.6",
		"@types/node": "^22.20.4",
		"@types/semver": "^7.8.0",
		"eslint": "^10.11.0",
		"husky": "^9.1.7",
		"lint-staged": "^16.4.0",
		"prettier": "^3.8.3",
		"rimraf": "^6.1.3",
		"typedoc": "^0.28.20",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.71.0",
		"vitest": "^4.1.11",
		"vitest-mock-extended": "^4.0.0"
	},
	"prettier": "@companion-module/tools/.prettierrc.json",
	"lint-staged": {
		"*.{css,json,md,scss}": [
			"prettier --write"
		],
		"*.{ts,tsx,js,jsx}": [
			"yarn lint:raw --fix"
		]
	},
	"packageManager": "yarn@4.18.0"
}
